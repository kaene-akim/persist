# Maintainer: Persist contributors
# Builds from a tagged git source. `sha256sums=('SKIP')` is correct for git
# sources; if you switch to a release tarball, replace it with the real digest.
#
# Building from a local checkout instead of the remote:
#   git archive --format=tar.gz --prefix=persist-0.1.0/ -o persist-0.1.0.tar.gz HEAD
#   # then change `source` to the local tarball and set its sha256.

pkgbase=persist
pkgname=(persist persist-desktop)
pkgver=0.1.0
pkgrel=1
pkgdesc="Incremental, versioned, content-addressable backups to Google Drive"
arch=('x86_64' 'aarch64')
url="https://github.com/persist-app/persist"
license=('MIT')
depends=('gcc-libs')
makedepends=('git' 'rust' 'cargo' 'nodejs' 'npm' 'pkgconf'
             'webkit2gtk-4.1' 'gtk3' 'libsoup3')
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd "$srcdir/persist"

  # Build the React frontend first: the Tauri backend embeds ui/dist at compile
  # time, so it must exist before cargo compiles persist-app.
  ( cd crates/persist-app/ui && npm install --no-audit --no-fund && npm run build )

  cargo build --release --workspace --frozen
}

package_persist() {
  pkgdesc="Command-line interface for Persist"
  depends=('gcc-libs')

  cd "$srcdir/persist"
  install -Dm755 target/release/persist "$pkgdir/usr/bin/persist"

  # Shell completions.
  install -d "$pkgdir/usr/share/bash-completion/completions"
  ./target/release/persist completions bash \
    > "$pkgdir/usr/share/bash-completion/completions/persist"
  install -d "$pkgdir/usr/share/fish/vendor_completions.d"
  ./target/release/persist completions fish \
    > "$pkgdir/usr/share/fish/vendor_completions.d/persist.fish"
  install -d "$pkgdir/usr/share/zsh/site-functions"
  ./target/release/persist completions zsh \
    > "$pkgdir/usr/share/zsh/site-functions/_persist"

  install -Dm644 README.md "$pkgdir/usr/share/doc/persist/README.md"
  install -Dm644 docs/cli.md "$pkgdir/usr/share/doc/persist/cli.md"
  install -Dm644 docs/backup-restore.md "$pkgdir/usr/share/doc/persist/backup-restore.md"
  install -Dm644 docs/google-oauth.md "$pkgdir/usr/share/doc/persist/google-oauth.md"
}

package_persist-desktop() {
  pkgdesc="Desktop application for Persist"
  depends=('gcc-libs' 'webkit2gtk-4.1' 'gtk3' 'libsoup3')

  cd "$srcdir/persist"
  install -Dm755 target/release/persist-app \
    "$pkgdir/usr/bin/persist-desktop"

  # Icons.
  install -Dm644 crates/persist-app/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/persist.png"
  install -Dm644 crates/persist-app/icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/persist.png"

  # Desktop entry.
  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/persist.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Persist
Comment=Incremental, versioned backups
Exec=persist-desktop
Icon=persist
Terminal=false
Categories=Utility;Archiving;FileTools;
EOF
}
